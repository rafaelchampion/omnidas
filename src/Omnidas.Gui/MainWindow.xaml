<Window x:Class="Omnidas.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Omnidas - Conversor Rápido" 
        Height="470" Width="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgDark}">

    <Grid Margin="20,15,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title / Header -->
            <RowDefinition Height="Auto"/> <!-- Source Info -->
            <RowDefinition Height="Auto"/> <!-- Target Formats -->
            <RowDefinition Height="*"/>    <!-- Diagnostic / Insight -->
            <RowDefinition Height="Auto"/> <!-- Progress / Action -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Omnidas" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Conversor Universal de Formatos" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
        </StackPanel>

        <!-- Source File/Folder Card -->
        <Border Grid.Row="1" Background="{StaticResource CardDark}" 
                CornerRadius="8" Padding="14" Margin="0,0,0,15" BorderBrush="{StaticResource CardStroke}" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtSourceItem" Text="Nenhum arquivo selecionado" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtSourceMeta" Text="Passe um arquivo ou pasta para converter" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Target Formats Quick Buttons -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Formato de Destino" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{StaticResource TextPrimary}"/>
            <WrapPanel x:Name="FormatsPanel" Orientation="Horizontal"/>
        </StackPanel>

        <!-- Insight & Info Card -->
        <Border Grid.Row="3" Background="{StaticResource CardDark}" 
                CornerRadius="8" Padding="12" Margin="0,0,0,15" BorderBrush="{StaticResource CardStroke}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="TxtInsightTitle" Text="Configuração Padrão" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentColor}" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtInsightBody" Text="Selecione um formato para visualizar as vantagens e estimativa." 
                           TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>
        </Border>

        <!-- Progress & Action -->
        <StackPanel Grid.Row="4">
            <ProgressBar x:Name="ConversionProgressBar" Height="6" Margin="0,0,0,8" Visibility="Collapsed" IsIndeterminate="True" Background="#333333" Foreground="{StaticResource AccentColor}"/>
            <TextBlock x:Name="TxtProgressStatus" Text="" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,8" Visibility="Collapsed" Foreground="{StaticResource TextSecondary}"/>
            
            <Button x:Name="BtnConvert" Content="Converter Agora" 
                    HorizontalAlignment="Stretch" Height="40" FontSize="13"
                    Click="BtnConvert_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
