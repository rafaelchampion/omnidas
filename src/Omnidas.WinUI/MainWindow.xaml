<Window
    x:Class="Omnidas_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Omnidas - Conversor Rápido">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid Margin="20,16,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Target File/Folder Banner -->
                <RowDefinition Height="Auto"/> <!-- Format Selection Pills -->
                <RowDefinition Height="*"/>    <!-- Smart Diagnostic Card -->
                <RowDefinition Height="Auto"/> <!-- Action / Progress Bar -->
            </Grid.RowDefinitions>

            <!-- 1. Header Fluent 2 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8AB;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Omnidas" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Conversão universal de alta fidelidade" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- 2. Source Item Card -->
            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,0,0,14">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="IconItemType" Glyph="&#xE8A5;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSourceItem" Text="Nenhum arquivo recebido" FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtSourceMeta" Text="Selecione um arquivo ou pasta pelo botão direito" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Format Selection Pills Grid -->
            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <TextBlock Text="Formato de Destino" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                <VariableSizedWrapGrid x:Name="FormatsPanel" Orientation="Horizontal" MaximumRowsOrColumns="4" ItemHeight="36"/>
            </StackPanel>

            <!-- 4. Smart Diagnostic & Pros/Cons Card -->
            <Border Grid.Row="3" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,0,0,16">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="TxtInsightTitle" Text="Diagnóstico Acústico" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtInsightBody" Text="Selecione um formato para calcular a estimativa e o impacto."
                               TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="3"/>

                    <!-- Micro-Medidores -->
                    <Grid RowSpacing="4" Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Text="Fidelidade" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <ProgressBar Grid.Row="0" Grid.Column="1" x:Name="BarQuality" Value="90" Height="4" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1" Text="Tamanho" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <ProgressBar Grid.Row="1" Grid.Column="1" x:Name="BarSize" Value="60" Height="4" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Text="Compatibilidade" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <ProgressBar Grid.Row="2" Grid.Column="1" x:Name="BarCompat" Value="100" Height="4" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5. Action / Progress Bar -->
            <StackPanel Grid.Row="4" Spacing="8">
                <ProgressBar x:Name="ConversionProgressBar" Height="4" Visibility="Collapsed" IsIndeterminate="True"/>
                <TextBlock x:Name="TxtProgressStatus" Text="" FontSize="11" HorizontalAlignment="Center" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <Button x:Name="BtnConvert" Content="Converter Agora" 
                        Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch" Height="36" FontWeight="SemiBold"
                        Click="BtnConvert_Click" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
